# Frontend/NestJS shared environment (copy to .env and fill with real values)
IS_SERVER=true
PRODUCTION_API_BASE_URL=https://api.stallionauto.com
LOCAL_API_BASE_URL=http://localhost:3002
MEDIA_BASE_URL=https://stallio-public.tor1.digitaloceanspaces.com
ADMIN_GALLERY_API_BASE_URL=
TOKEN_REFRESH_LEEWAY_SECONDS=20

# OAuth / Auth0 / Cognito etc.
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret
AUTH_AUDIENCE=your-api-audience
AUTH_ISSUER=https://your-issuer.example.com/
